<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Foreground for the adaptive launcher icon.
      Force a smaller, centered drawing area so the full artwork fits within launcher masks.
      Using item width/height avoids OEM launchers re-scaling inset drawables back to full size.
    -->
    <item
        android:width="72dp"
        android:height="72dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/icon"
            android:gravity="fill" />
    </item>

</layer-list>
