{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Android app (Gradle)",
			"type": "shell",
			"command": "./gradlew assembleDebug",
			"windows": {
				"command": ".\\gradlew.bat assembleDebug"
			},
			"isBackground": false,
			"problemMatcher": [
				"$javac"
			],
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "dedicated"
			},
			"group": "build"
		},
		{
			"label": "Install app on device (Gradle)",
			"type": "shell",
			"command": "./gradlew installDebug",
			"windows": {
				"command": ".\\gradlew.bat installDebug"
			},
			"isBackground": false,
			"problemMatcher": [
				"$javac"
			],
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "dedicated"
			},
			"group": "build"
		},
		{
			"label": "Build + Install + Launch (device)",
			"type": "shell",
			"command": "powershell -ExecutionPolicy Bypass -File ./tools/build_install_launch.ps1",
			"windows": {
				"command": "powershell -ExecutionPolicy Bypass -File .\\tools\\build_install_launch.ps1"
			},
			"isBackground": false,
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "dedicated"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Verify installed APK is TrimsyTRACK (com.trimsytrack)",
			"type": "shell",
			"command": "powershell -ExecutionPolicy Bypass -File ./tools/verify_installed_apk.ps1",
			"windows": {
				"command": "powershell -ExecutionPolicy Bypass -File .\\tools\\verify_installed_apk.ps1"
			},
			"isBackground": false,
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "Sync smoke test (interactive)",
			"type": "shell",
			"command": "powershell -ExecutionPolicy Bypass -File ./tools/smoke_sync_check.ps1 -DoRestart",
			"windows": {
				"command": "powershell -ExecutionPolicy Bypass -File .\\tools\\smoke_sync_check.ps1 -DoRestart"
			},
			"isBackground": false,
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "Sync smoke test (restart + reinstall + relogin)",
			"type": "shell",
			"command": "powershell -ExecutionPolicy Bypass -File ./tools/smoke_sync_check.ps1 -DoRestart -DoReinstall -AssumeYesForReinstall -NonInteractiveWaitAfterActionSeconds 60 -NonInteractiveWaitAfterReloginSeconds 90",
			"windows": {
				"command": "powershell -ExecutionPolicy Bypass -File .\\tools\\smoke_sync_check.ps1 -DoRestart -DoReinstall -AssumeYesForReinstall -NonInteractiveWaitAfterActionSeconds 60 -NonInteractiveWaitAfterReloginSeconds 90"
			},
			"isBackground": false,
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "dedicated"
			},
			"problemMatcher": []
		}
	]
}